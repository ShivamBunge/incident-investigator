# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
# Host-run app (default): postgres exposed by docker-compose on localhost
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/incident_investigator

# --- LLM via OpenRouter (OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-...your-key...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Embeddings (local, no API cost) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- MCP servers (spawned as child processes by the app) ---
MCP_TOOL_TIMEOUT_SECONDS=8
OBS_MCP_SERVER_CMD=python -m mcp_observability.server
K8S_MCP_SERVER_CMD=python -m mcp_kubernetes.server

# --- Kubernetes MCP ---
K8S_NAMESPACE=demo
# Optional: path to kubeconfig. Empty = in-cluster config, else default kubeconfig (~/.kube/config)
KUBECONFIG_PATH=